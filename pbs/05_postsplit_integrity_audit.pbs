#!/usr/bin/env bash
#PBS -N djrmcp-v0-split-audit
#PBS -q SMALL
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=06:00:00
#PBS -j oe

# This is CPU-only.  If APG has the shorter queue, submit with:
#   qsub -q APG pbs/05_postsplit_integrity_audit.pbs

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_FALLBACK="$(cd "$SCRIPT_DIR/.." && pwd -P)"
PROJECT_ROOT="${DJRMCP_PROJECT_ROOT:-${PROJECT_ROOT:-${PBS_O_WORKDIR:-$REPO_FALLBACK}}}"
if [[ ! -f "$PROJECT_ROOT/pyproject.toml" ]]; then
    echo "Project root is invalid; set DJRMCP_PROJECT_ROOT: $PROJECT_ROOT" >&2
    exit 2
fi
MASTER_MANIFEST="${MASTER_MANIFEST:-$PROJECT_ROOT/data/processed/v0/master_manifest.tsv}"
QUARANTINE_MANIFEST="${QUARANTINE_MANIFEST:-$PROJECT_ROOT/data/processed/v0/quarantine_manifest.tsv}"
MEMBERSHIP="${MEMBERSHIP:-$PROJECT_ROOT/data/processed/v0/global_component_membership.tsv}"
COMPONENT_FASTA="${COMPONENT_FASTA:-$PROJECT_ROOT/data/interim/v0/component_input.faa}"
MODEL_FASTA="${MODEL_FASTA:-$PROJECT_ROOT/data/interim/v0/model_representatives.faa}"
AUDIT_DIR="${AUDIT_DIR:-$PROJECT_ROOT/results/postsplit_integrity_v0}"
STAGING_DIR="${AUDIT_DIR}.building"
THREADS="${NCPUS:-8}"
JOB_TMP="${TMPDIR:-/tmp}/djrmcp_split_audit_${PBS_JOBID:-manual}"

cd "$PROJECT_ROOT"
source "${DJRMCP_MODULE_INIT:-/usr/share/Modules/init/bash}"
module load Python/3.11.7
module load mmseqs2/18-8cc5c

if [[ -e "$AUDIT_DIR" || -e "$STAGING_DIR" ]]; then
    echo "Refusing to overwrite post-split audit output: $AUDIT_DIR" >&2
    exit 2
fi
mkdir -p "$STAGING_DIR/raw" "$JOB_TMP"

MMSEQS_VERSION="$(mmseqs version 2>&1 | head -n 1)"
{
    echo "audit=postsplit_integrity_v0"
    echo "module=mmseqs2/18-8cc5c"
    echo "mmseqs_version=$MMSEQS_VERSION"
    echo "directions=validation->train,test->train,test->validation"
    echo "min_seq_id=0.30"
    echo "min_query_coverage=0.80"
    echo "min_target_coverage=0.80"
    echo "cov_mode=0"
    echo "sensitivity=7.5"
    echo "max_seqs=50000"
    echo "threads=$THREADS"
    echo "job_id=${PBS_JOBID:-manual}"
    echo "hostname=$(hostname)"
} > "$STAGING_DIR/RUN_METADATA.txt"

write_root_checksums() {
    (
        cd "$STAGING_DIR"
        find . -type f ! -name CHECKSUMS.sha256 -print0 \
            | LC_ALL=C sort -z \
            | xargs -0 sha256sum \
            > CHECKSUMS.sha256
    )
}

publish_preflight_failure() {
    local status="$1"
    echo "audit_exit_code=$status" >> "$STAGING_DIR/RUN_METADATA.txt"
    echo "audit_status=fail_preflight" >> "$STAGING_DIR/RUN_METADATA.txt"
    touch "$STAGING_DIR/RUN.FAIL"
    write_root_checksums
    mv "$STAGING_DIR" "$AUDIT_DIR"
    exit "$status"
}

set +e
python3 scripts/postsplit_integrity_audit.py prepare \
    --master-manifest "$MASTER_MANIFEST" \
    --quarantine-manifest "$QUARANTINE_MANIFEST" \
    --membership "$MEMBERSHIP" \
    --component-fasta "$COMPONENT_FASTA" \
    --model-fasta "$MODEL_FASTA" \
    --output-dir "$STAGING_DIR/inputs"
prepare_status=$?
set -e
if [[ "$prepare_status" -ne 0 ]]; then
    if [[ "$prepare_status" -eq 2 && -d "$STAGING_DIR/inputs" ]]; then
        publish_preflight_failure "$prepare_status"
    fi
    echo "Preparation crashed; partial output retained at $STAGING_DIR" >&2
    exit "$prepare_status"
fi

run_search() {
    local query_split="$1"
    local target_split="$2"
    local name="${query_split}_vs_${target_split}"
    mmseqs easy-search \
        "$STAGING_DIR/inputs/${query_split}_all_nodes.faa" \
        "$STAGING_DIR/inputs/${target_split}_all_nodes.faa" \
        "$STAGING_DIR/raw/${name}.raw.tsv" \
        "$JOB_TMP/$name" \
        -s 7.5 \
        --min-seq-id 0.30 \
        -c 0.80 \
        --cov-mode 0 \
        --max-seqs 50000 \
        --format-output 'query,target,pident,qcov,tcov,alnlen,evalue,bits' \
        --threads "$THREADS"
}

# The audit contract covers each unordered split pair once using the three
# stated query-to-target orientations.  qcov and tcov are checked separately by
# the finalizer.  The FASTA ID sets are disjoint, making every self hit invalid.
run_search validation train
run_search test train
run_search test validation

set +e
python3 scripts/postsplit_integrity_audit.py finalize \
    --preparation-dir "$STAGING_DIR/inputs" \
    --membership "$MEMBERSHIP" \
    --validation-vs-train "$STAGING_DIR/raw/validation_vs_train.raw.tsv" \
    --test-vs-train "$STAGING_DIR/raw/test_vs_train.raw.tsv" \
    --test-vs-validation "$STAGING_DIR/raw/test_vs_validation.raw.tsv" \
    --output-dir "$STAGING_DIR/report" \
    --min-seq-id 0.30 \
    --min-qcov 0.80 \
    --min-tcov 0.80
audit_status=$?
set -e

if [[ "$audit_status" -ne 0 && "$audit_status" -ne 2 ]]; then
    echo "Audit finalization crashed; partial output retained at $STAGING_DIR" >&2
    exit "$audit_status"
fi

echo "audit_exit_code=$audit_status" >> "$STAGING_DIR/RUN_METADATA.txt"
if [[ "$audit_status" -eq 0 ]]; then
    echo "audit_status=pass" >> "$STAGING_DIR/RUN_METADATA.txt"
    touch "$STAGING_DIR/RUN.PASS"
else
    echo "audit_status=fail_integrity" >> "$STAGING_DIR/RUN_METADATA.txt"
    touch "$STAGING_DIR/RUN.FAIL"
fi
write_root_checksums
mv "$STAGING_DIR" "$AUDIT_DIR"

echo "Post-split integrity audit published at: $AUDIT_DIR"
exit "$audit_status"
