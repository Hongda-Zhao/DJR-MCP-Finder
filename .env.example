# Copy these examples into your shell/session and replace every value with an
# absolute local path.  Do not commit a populated .env file.
export DJRMCP_PROJECT_ROOT=/absolute/path/to/DJR-MCP-Finder
export DJRMCP_ARCHIVE_ROOT=/absolute/path/to/checksum-bound-archives
export DJRMCP_DATABASE_ROOT=/absolute/path/to/frozen-input-databases
export DJRMCP_SOFTWARE_ROOT=/absolute/path/to/versioned-HPC-software
export DJRMCP_VENV_ROOT=/absolute/path/to/project-python-environment
# Optional when Environment Modules or workstation scratch live elsewhere:
# export DJRMCP_MODULE_INIT=/absolute/path/to/Modules/init/bash
# export DJRMCP_RUNTIME_ROOT=/absolute/path/to/fast-local-runtime

# Generated runtime configs should live outside the frozen configs/ directory,
# for example under the ignored build/ tree:
# python scripts/render_portable_config.py \
#   configs/v0_dataset.json build/local-configs/v0_dataset.json
