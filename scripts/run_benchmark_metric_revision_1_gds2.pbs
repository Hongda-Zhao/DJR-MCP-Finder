#!/bin/bash
#PBS -N djrmcp-metric-r1
#PBS -q SMALL
#PBS -l select=1:ncpus=12:mem=48gb
#PBS -l walltime=08:00:00
#PBS -j oe

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_FALLBACK="$(cd "$SCRIPT_DIR/.." && pwd -P)"
PROJECT_ROOT="${DJRMCP_PROJECT_ROOT:-${PROJECT_ROOT:-${PBS_O_WORKDIR:-$REPO_FALLBACK}}}"
if [[ ! -f "$PROJECT_ROOT/pyproject.toml" ]]; then
    echo "Project root is invalid; set DJRMCP_PROJECT_ROOT: $PROJECT_ROOT" >&2
    exit 2
fi
VENV_ROOT="${DJRMCP_VENV_ROOT:-${VENV_ROOT:-$PROJECT_ROOT/.venv-v0}}"
CONFIG="${DJRMCP_BENCHMARK_CONFIG:-$PROJECT_ROOT/configs/model_benchmark_v0_metric_revision_1.yaml}"

cd "${PROJECT_ROOT}"
source "${DJRMCP_MODULE_INIT:-/usr/share/Modules/init/bash}"
module load Python/3.11.7
if [[ ! -x "${VENV_ROOT}/bin/python" ]]; then
    echo "Project-V0 Python environment is missing: ${VENV_ROOT}" >&2
    exit 2
fi
export PATH="${VENV_ROOT}/bin:${PATH}"
export VIRTUAL_ENV="${VENV_ROOT}"
export PYTHONPATH="${PROJECT_ROOT}/src:${PYTHONPATH:-}"
export OMP_NUM_THREADS="${NCPUS:-12}"
export MKL_NUM_THREADS="${NCPUS:-12}"

if [[ -z "${BENCHMARK_MODEL_ID:-}" ]]; then
    echo "BENCHMARK_MODEL_ID is required" >&2
    exit 2
fi

echo "$(date --iso-8601=seconds) START metric-revision-1 ${BENCHMARK_MODEL_ID}"
python scripts/freeze_benchmark_cv_folds.py --config "${CONFIG}" --reuse-if-valid
python scripts/calibrate_benchmark_model.py \
    --config "${CONFIG}" \
    --model "${BENCHMARK_MODEL_ID}"
echo "$(date --iso-8601=seconds) COMPLETE metric-revision-1 ${BENCHMARK_MODEL_ID}"
